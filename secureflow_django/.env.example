# AI provider: yandex (cloud) or ollama (local)
DEFAULT_PROVIDER=yandex
YANDEX_IAM_TOKEN=
YANDEX_FOLDER_ID=
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:3b

# Notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_PROXY=
TELEGRAM_ADMIN_IDS=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS=true

# Optional Telegraph publishing token
TELEGRAPH_ACCESS_TOKEN=

DJANGO_SECRET_KEY=change-this-for-local-development
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
